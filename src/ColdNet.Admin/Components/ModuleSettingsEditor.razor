@using System.Collections
@using System.Reflection
@using System.Text.Json
@using System.Text.RegularExpressions

@if (SettingsType is null)
{
    <div class="mb-3">
        <label class="form-label text-muted">Module settings (JSON)</label>
        <textarea class="form-control font-monospace" rows="6" value="@_rawJson" @oninput="OnRawJsonInput"></textarea>
        @if (!string.IsNullOrEmpty(_jsonError))
        {
            <div class="text-danger small mt-1">@_jsonError</div>
        }
    </div>
}
else
{
    <div class="border rounded p-3 mb-3 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 text-primary">
                <i class="bi bi-sliders me-1"></i> Module configuration (@FormatTypeName(SettingsType.Name))
            </h6>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadDefaultTemplate" title="Reset all settings to default values">
                    Default template
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleRawJson">
                    @(_showRawJson ? "Hide JSON" : "Show JSON")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_jsonError))
        {
            <div class="alert alert-warning py-2 small mb-3">
                <strong>JSON Notice:</strong> @_jsonError
            </div>
        }

        @if (_settingsInstance is not null)
        {
            <div class="row g-3">
                @foreach (var prop in GetEditableProperties(SettingsType))
                {
                    var propType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
                    var displayName = FormatDisplayName(prop.Name);

                    @if (propType == typeof(bool))
                    {
                        var boolVal = (bool)(prop.GetValue(_settingsInstance) ?? false);
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="@GetFieldId(prop)"
                                       checked="@boolVal"
                                       @onchange="e => OnBoolChanged(prop, e.Value)" />
                                <label class="form-check-label" for="@GetFieldId(prop)">@displayName</label>
                            </div>
                        </div>
                    }
                    else if (IsNumericType(propType))
                    {
                        var numVal = prop.GetValue(_settingsInstance)?.ToString() ?? "0";
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1" for="@GetFieldId(prop)">@displayName</label>
                            <input type="number" class="form-control form-control-sm" id="@GetFieldId(prop)"
                                   value="@numVal"
                                   @oninput="e => OnNumberChanged(prop, e.Value?.ToString())" />
                        </div>
                    }
                    else if (propType == typeof(string))
                    {
                        var strVal = (string)(prop.GetValue(_settingsInstance) ?? string.Empty);
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1" for="@GetFieldId(prop)">@displayName</label>
                            <input type="text" class="form-control form-control-sm" id="@GetFieldId(prop)"
                                   value="@strVal"
                                   @oninput="e => OnStringChanged(prop, e.Value?.ToString())" />
                        </div>
                    }
                    else if (propType.IsEnum)
                    {
                        var currentEnum = prop.GetValue(_settingsInstance)?.ToString() ?? string.Empty;
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1" for="@GetFieldId(prop)">@displayName</label>
                            <select class="form-select form-select-sm" id="@GetFieldId(prop)"
                                    value="@currentEnum"
                                    @onchange="e => OnEnumChanged(prop, e.Value?.ToString())">
                                @foreach (var name in Enum.GetNames(propType))
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                        </div>
                    }
                    else if (propType == typeof(List<string>))
                    {
                        var listVal = (List<string>?)prop.GetValue(_settingsInstance) ?? [];
                        var joined = string.Join(", ", listVal);
                        <div class="col-12">
                            <label class="form-label small text-muted mb-1" for="@GetFieldId(prop)">
                                @displayName <span class="text-muted">(comma-separated)</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" id="@GetFieldId(prop)"
                                   value="@joined"
                                   placeholder="e.g. tmp, log, bak"
                                   @oninput="e => OnStringListChanged(prop, e.Value?.ToString())" />
                        </div>
                    }
                    else if (IsGenericListOfClass(propType, out var itemType))
                    {
                        var listObj = prop.GetValue(_settingsInstance) as IList;
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small text-muted mb-0">@displayName</label>
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2" @onclick="() => AddListItem(prop, itemType)">
                                    + Add @FormatDisplayName(itemType.Name)
                                </button>
                            </div>
                            @if (listObj is null || listObj.Count == 0)
                            {
                                <div class="text-muted small border rounded p-2 bg-light">No items configured.</div>
                            }
                            else
                            {
                                <div class="border rounded p-2 bg-light">
                                    @for (var i = 0; i < listObj.Count; i++)
                                    {
                                        var itemIndex = i;
                                        var item = listObj[itemIndex];
                                        <div class="card mb-2 shadow-sm">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge bg-secondary">#@(itemIndex + 1)</span>
                                                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1" @onclick="() => RemoveListItem(prop, itemIndex)">
                                                        Remove
                                                    </button>
                                                </div>
                                                <div class="row g-2">
                                                    @foreach (var itemProp in GetEditableProperties(itemType))
                                                    {
                                                        var itemPropType = Nullable.GetUnderlyingType(itemProp.PropertyType) ?? itemProp.PropertyType;
                                                        var itemPropDisplay = FormatDisplayName(itemProp.Name);
                                                        @if (itemPropType == typeof(bool))
                                                        {
                                                            var boolVal = (bool)(itemProp.GetValue(item) ?? false);
                                                            <div class="col-md-6 d-flex align-items-center">
                                                                <div class="form-check form-switch mt-1">
                                                                    <input class="form-check-input" type="checkbox"
                                                                           checked="@boolVal"
                                                                           @onchange="e => OnListItemBoolChanged(itemProp, item, e.Value)" />
                                                                    <label class="form-check-label small">@itemPropDisplay</label>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if (IsNumericType(itemPropType))
                                                        {
                                                            var numVal = itemProp.GetValue(item)?.ToString() ?? "0";
                                                            <div class="col-md-6">
                                                                <label class="form-label small text-muted mb-0">@itemPropDisplay</label>
                                                                <input type="number" class="form-control form-control-sm"
                                                                       value="@numVal"
                                                                       @oninput="e => OnListItemNumberChanged(itemProp, item, e.Value?.ToString())" />
                                                            </div>
                                                        }
                                                        else if (itemPropType == typeof(string))
                                                        {
                                                            var strVal = (string)(itemProp.GetValue(item) ?? string.Empty);
                                                            <div class="col-md-6">
                                                                <label class="form-label small text-muted mb-0">@itemPropDisplay</label>
                                                                <input type="text" class="form-control form-control-sm"
                                                                       value="@strVal"
                                                                       @oninput="e => OnListItemStringChanged(itemProp, item, e.Value?.ToString())" />
                                                            </div>
                                                        }
                                                        else if (itemPropType.IsEnum)
                                                        {
                                                            var currentEnum = itemProp.GetValue(item)?.ToString() ?? string.Empty;
                                                            <div class="col-md-6">
                                                                <label class="form-label small text-muted mb-0">@itemPropDisplay</label>
                                                                <select class="form-select form-select-sm"
                                                                        value="@currentEnum"
                                                                        @onchange="e => OnListItemEnumChanged(itemProp, item, e.Value?.ToString())">
                                                                    @foreach (var name in Enum.GetNames(itemPropType))
                                                                    {
                                                                        <option value="@name">@name</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        @if (_showRawJson)
        {
            <div class="mt-3 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small text-muted mb-0">Raw JSON representation</label>
                    <button type="button" class="btn btn-xs btn-link text-decoration-none py-0 px-0" @onclick="FormatJson">
                        Format JSON
                    </button>
                </div>
                <textarea class="form-control font-monospace" rows="6" value="@_rawJson" @oninput="OnRawJsonInput"></textarea>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Type? SettingsType { get; set; }
    [Parameter] public string SettingsJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> SettingsJsonChanged { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true, PropertyNameCaseInsensitive = true };

    private object? _settingsInstance;
    private string _rawJson = "{}";
    private string? _lastSyncedJson;
    private string? _jsonError;
    private bool _showRawJson;

    protected override void OnParametersSet()
    {
        if (_lastSyncedJson != SettingsJson)
        {
            _lastSyncedJson = SettingsJson;
            _rawJson = string.IsNullOrWhiteSpace(SettingsJson) ? "{}" : SettingsJson;
            SyncInstanceFromRawJson();
        }
    }

    private void SyncInstanceFromRawJson()
    {
        if (SettingsType is null)
        {
            _settingsInstance = null;
            _jsonError = null;
            return;
        }

        try
        {
            if (string.IsNullOrWhiteSpace(_rawJson) || _rawJson.Trim() == "{}")
            {
                _settingsInstance = Activator.CreateInstance(SettingsType);
                _rawJson = JsonSerializer.Serialize(_settingsInstance, SettingsType, JsonOptions);
                _jsonError = null;
            }
            else
            {
                var deserialized = JsonSerializer.Deserialize(_rawJson, SettingsType, JsonOptions);
                _settingsInstance = deserialized ?? Activator.CreateInstance(SettingsType);
                _jsonError = null;
            }
        }
        catch (JsonException ex)
        {
            _jsonError = ex.Message;
            _settingsInstance ??= Activator.CreateInstance(SettingsType);
        }
    }

    private async Task SyncJsonFromInstanceAsync()
    {
        if (_settingsInstance is null || SettingsType is null)
        {
            return;
        }

        try
        {
            _rawJson = JsonSerializer.Serialize(_settingsInstance, SettingsType, JsonOptions);
            _lastSyncedJson = _rawJson;
            _jsonError = null;
            await SettingsJsonChanged.InvokeAsync(_rawJson);
        }
        catch (Exception ex)
        {
            _jsonError = ex.Message;
        }
    }

    private async Task OnRawJsonInput(ChangeEventArgs e)
    {
        _rawJson = e.Value?.ToString() ?? "{}";
        _lastSyncedJson = _rawJson;
        await SettingsJsonChanged.InvokeAsync(_rawJson);

        if (SettingsType is not null)
        {
            try
            {
                if (string.IsNullOrWhiteSpace(_rawJson) || _rawJson.Trim() == "{}")
                {
                    _settingsInstance = Activator.CreateInstance(SettingsType);
                    _jsonError = null;
                }
                else
                {
                    var parsed = JsonSerializer.Deserialize(_rawJson, SettingsType, JsonOptions);
                    if (parsed is not null)
                    {
                        _settingsInstance = parsed;
                        _jsonError = null;
                    }
                }
            }
            catch (JsonException ex)
            {
                _jsonError = ex.Message;
            }
        }
    }

    private async Task LoadDefaultTemplate()
    {
        if (SettingsType is null) return;
        _settingsInstance = Activator.CreateInstance(SettingsType);
        await SyncJsonFromInstanceAsync();
    }

    private async Task FormatJson()
    {
        if (SettingsType is not null && _settingsInstance is not null)
        {
            await SyncJsonFromInstanceAsync();
        }
        else
        {
            try
            {
                using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(_rawJson) ? "{}" : _rawJson);
                _rawJson = JsonSerializer.Serialize(doc, JsonOptions);
                _lastSyncedJson = _rawJson;
                _jsonError = null;
                await SettingsJsonChanged.InvokeAsync(_rawJson);
            }
            catch (JsonException ex)
            {
                _jsonError = ex.Message;
            }
        }
    }

    private void ToggleRawJson() => _showRawJson = !_showRawJson;

    private async Task OnBoolChanged(PropertyInfo prop, object? value)
    {
        if (_settingsInstance is null) return;
        var boolVal = value is bool b ? b : (bool.TryParse(value?.ToString(), out var parsed) && parsed);
        prop.SetValue(_settingsInstance, boolVal);
        await SyncJsonFromInstanceAsync();
    }

    private async Task OnNumberChanged(PropertyInfo prop, string? valStr)
    {
        if (_settingsInstance is null) return;
        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        try
        {
            if (string.IsNullOrWhiteSpace(valStr))
            {
                prop.SetValue(_settingsInstance, Activator.CreateInstance(targetType));
            }
            else
            {
                var converted = Convert.ChangeType(valStr, targetType, System.Globalization.CultureInfo.InvariantCulture);
                prop.SetValue(_settingsInstance, converted);
            }
            await SyncJsonFromInstanceAsync();
        }
        catch
        {
            // invalid numeric input during typing
        }
    }

    private async Task OnStringChanged(PropertyInfo prop, string? value)
    {
        if (_settingsInstance is null) return;
        prop.SetValue(_settingsInstance, value ?? string.Empty);
        await SyncJsonFromInstanceAsync();
    }

    private async Task OnEnumChanged(PropertyInfo prop, string? enumStr)
    {
        if (_settingsInstance is null || string.IsNullOrWhiteSpace(enumStr)) return;
        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;
        if (Enum.TryParse(targetType, enumStr, ignoreCase: true, out var parsed))
        {
            prop.SetValue(_settingsInstance, parsed);
            await SyncJsonFromInstanceAsync();
        }
    }

    private async Task OnStringListChanged(PropertyInfo prop, string? text)
    {
        if (_settingsInstance is null) return;
        var items = (text ?? string.Empty)
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
        prop.SetValue(_settingsInstance, items);
        await SyncJsonFromInstanceAsync();
    }

    private async Task AddListItem(PropertyInfo prop, Type itemType)
    {
        if (_settingsInstance is null) return;
        var list = prop.GetValue(_settingsInstance) as IList;
        if (list is null)
        {
            list = Activator.CreateInstance(prop.PropertyType) as IList;
            prop.SetValue(_settingsInstance, list);
        }
        if (list is not null)
        {
            var newItem = Activator.CreateInstance(itemType);
            list.Add(newItem);
            await SyncJsonFromInstanceAsync();
        }
    }

    private async Task RemoveListItem(PropertyInfo prop, int index)
    {
        if (_settingsInstance is null) return;
        var list = prop.GetValue(_settingsInstance) as IList;
        if (list is not null && index >= 0 && index < list.Count)
        {
            list.RemoveAt(index);
            await SyncJsonFromInstanceAsync();
        }
    }

    private async Task OnListItemBoolChanged(PropertyInfo itemProp, object? item, object? value)
    {
        if (item is null) return;
        var boolVal = value is bool b ? b : (bool.TryParse(value?.ToString(), out var parsed) && parsed);
        itemProp.SetValue(item, boolVal);
        await SyncJsonFromInstanceAsync();
    }

    private async Task OnListItemNumberChanged(PropertyInfo itemProp, object? item, string? valStr)
    {
        if (item is null) return;
        var targetType = Nullable.GetUnderlyingType(itemProp.PropertyType) ?? itemProp.PropertyType;
        try
        {
            if (string.IsNullOrWhiteSpace(valStr))
            {
                itemProp.SetValue(item, Activator.CreateInstance(targetType));
            }
            else
            {
                var converted = Convert.ChangeType(valStr, targetType, System.Globalization.CultureInfo.InvariantCulture);
                itemProp.SetValue(item, converted);
            }
            await SyncJsonFromInstanceAsync();
        }
        catch
        {
        }
    }

    private async Task OnListItemStringChanged(PropertyInfo itemProp, object? item, string? value)
    {
        if (item is null) return;
        itemProp.SetValue(item, value ?? string.Empty);
        await SyncJsonFromInstanceAsync();
    }

    private async Task OnListItemEnumChanged(PropertyInfo itemProp, object? item, string? enumStr)
    {
        if (item is null || string.IsNullOrWhiteSpace(enumStr)) return;
        var targetType = Nullable.GetUnderlyingType(itemProp.PropertyType) ?? itemProp.PropertyType;
        if (Enum.TryParse(targetType, enumStr, ignoreCase: true, out var parsed))
        {
            itemProp.SetValue(item, parsed);
            await SyncJsonFromInstanceAsync();
        }
    }

    private static IEnumerable<PropertyInfo> GetEditableProperties(Type type) =>
        type.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(p => p.CanRead && p.CanWrite);

    private static bool IsNumericType(Type type) =>
        type == typeof(int) || type == typeof(long) || type == typeof(short) ||
        type == typeof(byte) || type == typeof(double) || type == typeof(float) ||
        type == typeof(decimal);

    private static bool IsGenericListOfClass(Type type, out Type itemType)
    {
        itemType = typeof(object);
        if (type.IsGenericType && typeof(IList).IsAssignableFrom(type))
        {
            var genArgs = type.GetGenericArguments();
            if (genArgs.Length == 1 && genArgs[0].IsClass && genArgs[0] != typeof(string))
            {
                itemType = genArgs[0];
                return true;
            }
        }
        return false;
    }

    private static string FormatTypeName(string name)
    {
        if (name.EndsWith("Settings"))
        {
            name = name[..^8];
        }
        return FormatDisplayName(name);
    }

    private static string FormatDisplayName(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name;
        var formatted = Regex.Replace(name, "([a-z0-9])([A-Z])", "$1 $2");
        formatted = Regex.Replace(formatted, @"\bLibre Office\b", "LibreOffice", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bJob Id\b", "Job ID", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bPdf\b", "PDF", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bDms\b", "DMS", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bXml\b", "XML", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bBom\b", "BOM", RegexOptions.IgnoreCase);
        formatted = Regex.Replace(formatted, @"\bUrl\b", "URL", RegexOptions.IgnoreCase);
        return formatted;
    }

    private static string GetFieldId(PropertyInfo prop) => $"fld_{prop.DeclaringType?.Name}_{prop.Name}";
}
