@page "/"
@rendermode InteractiveServer
@using System.Text
@using ColdNet.Core.ExportImport
@using ColdNet.Core.Security
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<ColdNetDbContext> DbFactory
@inject ModuleRegistry Registry
@inject ISecretProtector SecretProtector
@inject NavigationManager Nav

<PageTitle>ColdNet Admin - Process groups</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Process groups</h1>
    <div>
        <button class="btn btn-outline-secondary me-2" @onclick="ToggleImportModal">Import</button>
        <button class="btn btn-primary" @onclick="() => { _showNewGroup = !_showNewGroup; if (_showNewGroup) _showImport = false; }">New group</button>
    </div>
</div>

@if (_showImport)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Import process chain or group</h5>
            <button type="button" class="btn-close" aria-label="Close" @onclick="CloseImport"></button>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_importError))
            {
                <div class="alert alert-danger">@_importError</div>
            }
            @if (!string.IsNullOrEmpty(_importSuccessMessage))
            {
                <div class="alert alert-success">@_importSuccessMessage</div>
            }

            <div class="mb-3">
                <label class="form-label">Select JSON file or paste JSON configuration below:</label>
                <InputFile OnChange="HandleImportFileSelected" class="form-control mb-2" accept=".json" />
                <textarea class="form-control font-monospace" rows="5" placeholder="Paste JSON here..." value="@_importJson" @oninput="OnImportJsonInput"></textarea>
            </div>

            @if (_parsedImportResult != null && _parsedImportResult.Success)
            {
                <div class="alert alert-info">
                    @if (_parsedImportResult.Type == ImportPackageType.Group && _parsedImportResult.Group != null)
                    {
                        <div><strong>Detected Process Group:</strong> @_parsedImportResult.Group.Name (@_parsedImportResult.Group.Chains.Count chain(s))</div>
                        @if (!string.IsNullOrWhiteSpace(_parsedImportResult.Group.Description))
                        {
                            <div class="small text-muted">@_parsedImportResult.Group.Description</div>
                        }
                    }
                    else if (_parsedImportResult.Type == ImportPackageType.Chain && _parsedImportResult.Chain != null)
                    {
                        <div><strong>Detected Process Chain:</strong> @_parsedImportResult.Chain.Name (@_parsedImportResult.Chain.Modules.Count module(s))</div>
                        <div class="small text-muted">Worker: @_parsedImportResult.Chain.WorkerName</div>
                        <div class="mt-2">
                            <label class="form-label">Target Process Group:</label>
                            <select class="form-select" @bind="_importTargetGroupId">
                                @if (_groups != null)
                                {
                                    @foreach (var g in _groups)
                                    {
                                        <option value="@g.Id">@g.Name @(g.IsDefault ? "(default)" : "")</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseImport">Cancel</button>
                <button type="button" class="btn btn-success" disabled="@(_parsedImportResult == null || !_parsedImportResult.Success)" @onclick="ExecuteImportAsync">Import now</button>
            </div>
        </div>
    </div>
}

@if (_showNewGroup)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">New process group</h5>
            <div class="row g-2">
                <div class="col-md-4">
                    <input class="form-control" placeholder="Name" @bind="_newGroupName" />
                </div>
                <div class="col-md-3">
                    <input class="form-control" placeholder="Short name (max 10)" maxlength="10" @bind="_newGroupShortName" />
                </div>
                <div class="col-md-4">
                    <input class="form-control" placeholder="Description" @bind="_newGroupDescription" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-success w-100" @onclick="CreateGroupAsync">Create</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_groups is null)
{
    <p><em>Loading...</em></p>
}
else if (_groups.Count == 0)
{
    <p class="text-muted">No process groups yet.</p>
}
else
{
    @foreach (var group in _groups)
    {
        var status = _groupStatuses[group.Id];
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <span class="status-dot status-@status.ToString().ToLowerInvariant()"></span>
                    <strong>@group.Name</strong>
                    @if (group.IsDefault)
                    {
                        <span class="badge bg-secondary ms-2">default</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(group.Description))
                    {
                        <span class="text-muted ms-2">@group.Description</span>
                    }
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleNewChain(group.Id)">New chain</button>
                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => OpenImportForGroup(group.Id)">Import chain</button>
                    <a href="/api/export/groups/@group.Id" class="btn btn-sm btn-outline-secondary ms-2" download="@($"{group.Name}.coldgroup.json")">Export group</a>
                    @if (!group.IsDefault)
                    {
                        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteGroupAsync(group.Id)">Delete</button>
                    }
                </div>
            </div>

            @if (_newChainGroupId == group.Id)
            {
                <div class="card-body border-bottom bg-light">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input class="form-control" placeholder="Chain name" @bind="_newChainName" />
                        </div>
                        <div class="col-md-3">
                            <input class="form-control" placeholder="Worker name" @bind="_newChainWorkerName" />
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" @bind="_newChainImportModuleType" title="Import module (module 0) - where this chain picks up new jobs from">
                                @foreach (var entry in Registry.ByCategory(ModuleCategory.Import).OrderBy(e => e.DisplayName))
                                {
                                    <option value="@entry.TypeName">@entry.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-success w-100" @onclick="() => CreateChainAsync(group.Id)">Create chain</button>
                        </div>
                    </div>
                </div>
            }

            <ul class="list-group list-group-flush">
                @foreach (var chain in group.Chains)
                {
                    var chainStatus = _chainStatuses[chain.Id];
                    var counts = _jobCounts.GetValueOrDefault(chain.Id, new JobCounts());
                    <li class="list-group-item d-flex justify-content-between align-items-center chain-row" @onclick='() => Nav.NavigateTo($"/chains/{chain.Id}")'>
                        <div>
                            <span class="status-dot status-@chainStatus.ToString().ToLowerInvariant()"></span>
                            <strong>@chain.Name</strong>
                            <span class="text-muted ms-2">worker: @chain.WorkerName</span>
                            <span class="text-muted ms-2">@chain.Modules.Count module(s)</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-light text-dark border me-1" title="Ready">R: @counts.Ready</span>
                            <span class="badge bg-light text-dark border me-1" title="Working">W: @counts.Working</span>
                            <span class="badge @(counts.Error > 0 ? "bg-danger" : "bg-light text-dark border") me-2" title="Error">E: @counts.Error</span>
                            <a href="/api/export/chains/@chain.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" download="@($"{chain.Name}.coldchain.json")" @onclick:stopPropagation="true" title="Export chain">Export</a>
                        </div>
                    </li>
                }
                @if (group.Chains.Count == 0)
                {
                    <li class="list-group-item text-muted">No process chains in this group yet.</li>
                }
            </ul>
        </div>
    }
}

<style>
    .status-dot { display:inline-block; width:10px; height:10px; border-radius:50%; margin-right:6px; }
    .status-grey { background-color:#adb5bd; }
    .status-yellow { background-color:#ffc107; }
    .status-red { background-color:#dc3545; }
    .status-green { background-color:#198754; }
    .chain-row { cursor:pointer; }
    .chain-row:hover { background-color: var(--bs-tertiary-bg, #f8f9fa); }
</style>

@code {
    private List<ProcessGroup>? _groups;
    private Dictionary<Guid, GroupStatus> _groupStatuses = new();
    private Dictionary<Guid, ChainStatus> _chainStatuses = new();
    private Dictionary<Guid, JobCounts> _jobCounts = new();

    private bool _showNewGroup;
    private string _newGroupName = string.Empty;
    private string _newGroupShortName = string.Empty;
    private string _newGroupDescription = string.Empty;

    private Guid? _newChainGroupId;
    private string _newChainName = string.Empty;
    private string _newChainWorkerName = "default";
    private string _newChainImportModuleType = "ColdImport";

    private bool _showImport;
    private string _importJson = string.Empty;
    private Guid? _importTargetGroupId;
    private ImportResult? _parsedImportResult;
    private string? _importError;
    private string? _importSuccessMessage;

    private enum GroupStatus { Grey, Yellow, Red, Green }
    private enum ChainStatus { Grey, Yellow, Red, Green }

    private class JobCounts
    {
        public int Ready { get; set; }
        public int Working { get; set; }
        public int Error { get; set; }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        _groups = await db.ProcessGroups
            .Include(g => g.Chains).ThenInclude(c => c.Modules)
            .OrderBy(g => g.IsDefault ? 0 : 1).ThenBy(g => g.Name)
            .ToListAsync();

        var counts = await db.Jobs
            .Where(j => j.Status == JobStatus.Ready || j.Status == JobStatus.Working || j.Status == JobStatus.Error)
            .GroupBy(j => new { j.ProcessChainId, j.Status })
            .Select(g => new { g.Key.ProcessChainId, g.Key.Status, Count = g.Count() })
            .ToListAsync();

        _jobCounts = new Dictionary<Guid, JobCounts>();
        foreach (var c in counts)
        {
            if (!_jobCounts.TryGetValue(c.ProcessChainId, out var jc))
            {
                jc = new JobCounts();
                _jobCounts[c.ProcessChainId] = jc;
            }

            switch (c.Status)
            {
                case JobStatus.Ready: jc.Ready = c.Count; break;
                case JobStatus.Working: jc.Working = c.Count; break;
                case JobStatus.Error: jc.Error = c.Count; break;
            }
        }

        _chainStatuses = new Dictionary<Guid, ChainStatus>();
        _groupStatuses = new Dictionary<Guid, GroupStatus>();

        foreach (var group in _groups)
        {
            var anyError = false;
            var anyRunning = false;
            var anyEnabled = false;

            foreach (var chain in group.Chains)
            {
                var jc = _jobCounts.GetValueOrDefault(chain.Id, new JobCounts());
                ChainStatus status;
                if (!chain.Enabled)
                {
                    status = ChainStatus.Grey;
                }
                else
                {
                    anyEnabled = true;
                    if (jc.Error > 0)
                    {
                        status = ChainStatus.Red;
                    }
                    else if (chain.IsRunning)
                    {
                        status = ChainStatus.Green;
                        anyRunning = true;
                    }
                    else
                    {
                        status = ChainStatus.Yellow;
                    }
                }

                _chainStatuses[chain.Id] = status;
                if (status == ChainStatus.Red)
                {
                    anyError = true;
                }
            }

            _groupStatuses[group.Id] = !anyEnabled
                ? GroupStatus.Grey
                : anyError
                    ? GroupStatus.Red
                    : anyRunning
                        ? GroupStatus.Green
                        : GroupStatus.Yellow;
        }
    }

    private void ToggleImportModal()
    {
        _showImport = !_showImport;
        if (_showImport)
        {
            _showNewGroup = false;
            _newChainGroupId = null;
            _importTargetGroupId = _groups?.FirstOrDefault()?.Id;
            _importError = null;
            _importSuccessMessage = null;
            _importJson = string.Empty;
            _parsedImportResult = null;
        }
    }

    private void OpenImportForGroup(Guid groupId)
    {
        _showImport = true;
        _showNewGroup = false;
        _newChainGroupId = null;
        _importTargetGroupId = groupId;
        _importError = null;
        _importSuccessMessage = null;
        _importJson = string.Empty;
        _parsedImportResult = null;
    }

    private void CloseImport()
    {
        _showImport = false;
        _importJson = string.Empty;
        _parsedImportResult = null;
        _importError = null;
        _importSuccessMessage = null;
    }

    private async Task HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        _importError = null;
        _importSuccessMessage = null;
        try
        {
            var file = e.File;
            if (file == null) return;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            _importJson = await reader.ReadToEndAsync();
            ParseImportJson();
        }
        catch (Exception ex)
        {
            _importError = $"Error reading file: {ex.Message}";
            _parsedImportResult = null;
        }
    }

    private void OnImportJsonInput(ChangeEventArgs e)
    {
        _importJson = e.Value?.ToString() ?? string.Empty;
        ParseImportJson();
    }

    private void ParseImportJson()
    {
        _importError = null;
        _importSuccessMessage = null;
        if (string.IsNullOrWhiteSpace(_importJson))
        {
            _parsedImportResult = null;
            return;
        }

        var targetId = _importTargetGroupId ?? _groups?.FirstOrDefault()?.Id ?? Guid.Empty;
        _parsedImportResult = ProcessExportImportService.Import(_importJson, targetId);
        if (!_parsedImportResult.Success)
        {
            _importError = _parsedImportResult.ErrorMessage ?? "Could not parse JSON configuration.";
        }
    }

    private async Task ExecuteImportAsync()
    {
        if (_parsedImportResult == null || !_parsedImportResult.Success)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        if (_parsedImportResult.Type == ImportPackageType.Group && _parsedImportResult.Group != null)
        {
            var group = _parsedImportResult.Group;
            foreach (var importedChain in group.Chains)
            {
                EncryptChainModuleSettings(importedChain);
            }
            db.ProcessGroups.Add(group);
            await db.SaveChangesAsync();

            _importSuccessMessage = $"Process Group '{group.Name}' imported successfully with {group.Chains.Count} chain(s)!";
            _importJson = string.Empty;
            _parsedImportResult = null;
            await LoadAsync();
        }
        else if (_parsedImportResult.Type == ImportPackageType.Chain && _parsedImportResult.Chain != null)
        {
            var targetGroupId = _importTargetGroupId;
            if (targetGroupId == null || targetGroupId == Guid.Empty)
            {
                var defaultGroup = _groups?.FirstOrDefault(g => g.IsDefault) ?? _groups?.FirstOrDefault();
                targetGroupId = defaultGroup?.Id;
            }

            if (targetGroupId == null || targetGroupId == Guid.Empty)
            {
                _importError = "Please select a target process group.";
                return;
            }

            var chain = _parsedImportResult.Chain;
            chain.ProcessGroupId = targetGroupId.Value;
            EncryptChainModuleSettings(chain);
            db.ProcessChains.Add(chain);
            await db.SaveChangesAsync();

            _importSuccessMessage = $"Process Chain '{chain.Name}' imported successfully!";
            _importJson = string.Empty;
            _parsedImportResult = null;
            await LoadAsync();
        }
    }

    /// <summary>
    /// Imported SettingsJson is plaintext (an export either predates this feature or already
    /// redacted secrets - either way there's nothing encrypted to decrypt) - encrypt sensitive
    /// fields before they ever touch the database, same as a normal save in the module editor.
    /// </summary>
    private void EncryptChainModuleSettings(ProcessChain chain)
    {
        foreach (var module in chain.Modules)
        {
            var settingsType = Registry.Find(module.ModuleTypeName)?.SettingsType;
            module.SettingsJson = SettingsEncryption.Encrypt(module.SettingsJson, settingsType, SecretProtector);
        }
    }

    private async Task CreateGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_newGroupName))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.ProcessGroups.Add(new ProcessGroup
        {
            Name = _newGroupName,
            ShortName = string.IsNullOrWhiteSpace(_newGroupShortName)
                ? _newGroupName[..Math.Min(10, _newGroupName.Length)]
                : _newGroupShortName,
            Description = _newGroupDescription,
        });
        await db.SaveChangesAsync();

        _newGroupName = _newGroupShortName = _newGroupDescription = string.Empty;
        _showNewGroup = false;
        await LoadAsync();
    }

    private async Task DeleteGroupAsync(Guid groupId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var group = await db.ProcessGroups.Include(g => g.Chains).FirstOrDefaultAsync(g => g.Id == groupId);
        if (group is null || group.IsDefault)
        {
            return;
        }

        db.ProcessGroups.Remove(group);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private void ToggleNewChain(Guid groupId)
    {
        _newChainGroupId = _newChainGroupId == groupId ? null : groupId;
        _newChainName = string.Empty;
        _newChainWorkerName = "default";
        _newChainImportModuleType = "ColdImport";
    }

    private async Task CreateChainAsync(Guid groupId)
    {
        if (string.IsNullOrWhiteSpace(_newChainName))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var chain = new ProcessChain
        {
            ProcessGroupId = groupId,
            Name = _newChainName,
            WorkerName = string.IsNullOrWhiteSpace(_newChainWorkerName) ? "default" : _newChainWorkerName,
        };

        var importModuleType = string.IsNullOrWhiteSpace(_newChainImportModuleType) ? "ColdImport" : _newChainImportModuleType;
        var importEntry = Registry.Find(importModuleType);

        chain.Modules.Add(new ModuleInstance
        {
            ProcessChainId = chain.Id,
            Order = 0,
            ModuleTypeName = importModuleType,
            DisplayName = importEntry?.DisplayName ?? "Import",
        });

        db.ProcessChains.Add(chain);
        await db.SaveChangesAsync();

        _newChainGroupId = null;
        Nav.NavigateTo($"/chains/{chain.Id}");
    }
}
