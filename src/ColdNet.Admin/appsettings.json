{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ColdNet": "Data Source=../../data/coldnet.db"
  },
  "ColdNet": {
    "Database": {
      "Provider": "Sqlite"
    },
    "Worker": {
      "WorkerName": "default",
      "PollIntervalSeconds": 5
    },
    "EdmVault": {
      "Connector": "FileDrop",
      "RestApi": {
        "BaseUrl": "https://localhost:7031",
        "UserName": "",
        "Password": "",
        "ProjectLookupCacheMinutes": 10
      }
    }
  }
}
