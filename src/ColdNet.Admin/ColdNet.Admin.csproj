<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ColdNet.Core\ColdNet.Core.csproj" />
    <ProjectReference Include="..\ColdNet.Data\ColdNet.Data.csproj" />
    <ProjectReference Include="..\ColdNet.Modules\ColdNet.Modules.csproj" />
    <ProjectReference Include="..\ColdNet.Engine\ColdNet.Engine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- No culture-specific formatting anywhere in the app; avoids depending on the target Linux
         host having libicu installed for the self-contained release to "just work". -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
